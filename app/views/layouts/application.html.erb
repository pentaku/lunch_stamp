<!DOCTYPE html>
<html>
  <head>
    <title>LunchStamp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <%= render "shared/header" %>
    <main class="app-main">
      <div class="container-fluid app-shell">
        <%= yield %>
      </div>
    </main>

    <footer class="app-footer border-top bg-white py-3">
      <div class="container-fluid app-shell">
        <div class="footer-links d-flex flex-column flex-md-row justify-content-center align-items-center gap-2">
          <%= link_to "利用規約", "#", class: "text-muted" %>
          <span class="d-none d-md-inline text-muted">|</span>
          <%= link_to "プライバシーポリシー", "#", class: "text-muted" %>
          <span class="d-none d-md-inline text-muted">|</span>
          <%= link_to "お問い合わせ", "#", class: "text-muted" %>
        </div>

        <p class="footer-copy text-center mb-0 mt-2">
          © 2026 Lunch Stamp
        </p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>