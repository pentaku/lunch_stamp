<!DOCTYPE html>
<html>
  <head>
    <title>LunchStamp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <%= render "shared/header" %>
    <main class="app-main">
      <div class="container-fluid app-shell">
        <% flash.each do |message_type, message| %>
          <div class="alert alert-<%= message_type %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </div>
    </main>
    <%= render "shared/footer" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      // Turbo遷移後でもハンバーガーメニューの開閉を確実に動かす
      document.addEventListener("turbo:load", function () {
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function (toggler) {
          if (toggler.dataset.collapseInitialized) return;
          toggler.dataset.collapseInitialized = "true";

          toggler.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();

            const target = document.querySelector(toggler.getAttribute("data-bs-target"));
            if (!target) return;

            const collapse = bootstrap.Collapse.getOrCreateInstance(target, { toggle: false });
            collapse.toggle();
          });
        });
      });
    </script>
  </body>
</html>