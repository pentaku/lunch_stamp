<!DOCTYPE html>
<html>
  <head>
    <title>LunchStamp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-light">
    <header>
      <nav class="navbar navbar-expand-lg border-bottom bg-white">
        <div class="container">
          <%= link_to "🍱 Lunch Stamp", root_path, class: "navbar-brand fw-bold text-warning" %>

          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto align-items-lg-center">
              <li class="nav-item">
                <%= link_to "ログイン", "#", class: "nav-link" %>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="py-4">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <footer class="border-top bg-white py-3 mt-5">
      <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-2 small text-muted">
          <%= link_to "利用規約", "#", class: "text-muted text-decoration-none" %>
          <span class="d-none d-md-inline">|</span>
          <%= link_to "プライバシーポリシー", "#", class: "text-muted text-decoration-none" %>
          <span class="d-none d-md-inline">|</span>
          <%= link_to "お問い合わせ", "#", class: "text-muted text-decoration-none" %>
        </div>

        <p class="text-center text-muted small mb-0 mt-2">
          © 2026 Lunch Stamp
        </p>
      </div>
    </footer>
  </body>
</html>
