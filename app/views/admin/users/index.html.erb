<div class="ls-page-bg">
  <div class="ls-page-container">

    <div class="section-title-box">
      <p class="section-title-text">管理画面 — ユーザー一覧</p>
    </div>

    <p class="text-muted mb-3">登録ユーザー数：<strong><%= @users.size %></strong> 件</p>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>名前</th>
            <th>メールアドレス</th>
            <th>有効化</th>
            <th>管理者</th>
            <th>登録日時</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td>
                <% if user.activated? %>
                  <span class="badge bg-success">有効</span>
                <% else %>
                  <span class="badge bg-secondary">未有効化</span>
                <% end %>
              </td>
              <td>
                <% if user.admin? %>
                  <span class="badge bg-danger">管理者</span>
                <% end %>
              </td>
              <td><%= user.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>
