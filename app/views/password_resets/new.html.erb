<div class="ls-page-bg">
  <div class="ls-page-container">
    <div class="ls-title-box">
      <h1 class="ls-title-text">パスワード再設定</h1>
    </div>

    <div class="ls-form-card">
      <p class="ls-form-description">
        登録済みのメールアドレスを入力してください。<br>
        パスワード再設定用のメールを送信します。
      </p>

      <% if flash.now[:danger] %>
        <div class="alert alert-danger">
          <%= flash.now[:danger] %>
        </div>
      <% end %>

      <%= form_with(url: password_resets_path, scope: :password_reset) do |f| %>
        <div class="ls-form-group">
          <%= f.label :email, "メールアドレス", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.email_field :email,
                              class: "ls-form-input",
                              placeholder: "email@example.com",
                              autocomplete: "email" %>
            <span class="ls-input-icon">✉</span>
          </div>
        </div>

        <div class="ls-submit-wrap">
          <%= f.submit "送信する", class: "ls-submit-button" %>
        </div>
      <% end %>

      <div class="ls-back-link">
        <%= link_to "ログイン画面に戻る", login_path, class: "common-link" %>
      </div>
    </div>
  </div>
</div>
