<div class="ls-page-bg">
  <div class="ls-page-container">
    <div class="ls-title-box">
      <h1 class="ls-title-text">ログイン</h1>
    </div>

    <div class="ls-form-card">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type %>">
          <%= message %>
        </div>
      <% end %>

      <%= form_with(url: login_path, scope: :session, local: true) do |f| %>
        <div class="ls-form-group">
          <%= f.label :email, "メールアドレスを入力してください", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.email_field :email,
                              class: "ls-form-input",
                              placeholder: "email@email.com",
                              autocomplete: "email",
                              value: @email %>
            <span class="ls-input-icon">✉</span>
          </div>
        </div>

        <div class="ls-form-group">
          <%= f.label :password, "パスワードを入力してください", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.password_field :password,
                                 class: "ls-form-input",
                                 placeholder: "************",
                                 autocomplete: "current-password" %>
            <span class="ls-input-icon">🔑</span>
          </div>
        </div>

        <%= f.label :remember_me, class: "login-remember" do %>
          <%= f.check_box :remember_me %>
          <span>ログイン状態を保持する</span>
        <% end %>

        <div class="login-forgot-password">
          <%= link_to "パスワードを忘れた場合", new_password_reset_path, class: "common-link" %>
        </div>

        <div class="ls-submit-wrap">
          <%= f.submit "ログイン", class: "ls-submit-button" %>
        </div>
      <% end %>
    </div>
  </div>
</div>