<header>
  <nav class="navbar navbar-expand-lg border-bottom bg-white">
    <div class="container-fluid app-shell">
      <%= link_to "🍱 Lunch Stamp", root_path, class: "navbar-brand text-warning" %>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarSupportedContent">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <% if logged_in? %>
            <li class="nav-item">
              <%= link_to "店舗一覧", restaurants_path, class: "nav-link px-0 px-lg-3" %>
            </li>
            <li class="nav-item">
              <%= link_to "マイページ", current_user, class: "nav-link px-0 px-lg-3" %>
            </li>
            <li class="nav-item">
              <%= link_to "プロフィール編集", edit_user_path(current_user),
                          class: "nav-link px-0 px-lg-3" %>
            </li>
            <li class="nav-item">
              <%= link_to "ログアウト", logout_path,
                          data: { turbo_method: :delete },
                          class: "nav-link px-0 px-lg-3" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "ログイン", login_path, class: "nav-link px-0 px-lg-3" %>
            </li>
            <li class="nav-item">
              <%= link_to "新規登録", signup_path, class: "nav-link px-0 px-lg-3" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>