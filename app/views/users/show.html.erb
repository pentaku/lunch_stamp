<div class="ls-page-bg">
  <div class="ls-page-container">

    <%# プロフィール %>
    <section class="page-section">
      <div class="section-title-box">
        <h1 class="section-title-text">マイページ</h1>
      </div>

      <div class="info-card">
        <div class="mypage-profile-row">
          <span class="mypage-label">名前：</span>
          <span class="mypage-value"><%= @user.name %></span>
        </div>

        <div class="mypage-profile-row">
          <span class="mypage-label">メールアドレス：</span>
          <span class="mypage-value"><%= @user.email %></span>
        </div>

        <div class="mypage-profile-row">
          <span class="mypage-label">パスワード：</span>
          <span class="mypage-value">********</span>

          <%= link_to "プロフィール編集",
                      edit_user_path(@user),
                      class: "common-link mypage-edit-link" %>
        </div>
      </div>
    </section>

    <%# スタンプ進捗 %>
    <section class="page-section">
      <div class="mypage-progress-card">
        <p class="mypage-progress-title">📊 人形町スタンプ進捗</p>

        <p class="mypage-progress-text">
          訪問数：<%= @visited_count %> / <%= @total_restaurants_count %>店
        </p>

        <p class="mypage-progress-text">
          達成率：<%= @completion_rate %>%
        </p>

        <div class="mypage-progress-bar">
          <div class="mypage-progress-fill"
              style="width: <%= @completion_rate %>%;"></div>
        </div>
      </div>
    </section>

    <%# 最近行ったお店 %>
    <section class="page-section">
      <div class="section-title-box">
        <h2 class="section-title-text">最近行ったお店</h2>
      </div>

      <% if @visits.any? %>
        <% @visits.each do |visit| %>
          <% restaurant = visit.restaurant %>

          <div class="mypage-shop-card">
            <% if restaurant.photo_url.present? %>
              <div class="mypage-shop-image">
                <%= image_tag restaurant.photo_url,
                              alt: restaurant.name %>
              </div>
            <% end %>

            <div class="mypage-shop-body">
              <p class="mypage-shop-title">
                <%= restaurant.name %>
              </p>

              <p class="mypage-shop-meta">
                エリア：<%= restaurant.area %>
              </p>

              <p class="mypage-shop-meta">
                ジャンル：<%= restaurant.genre %>
              </p>

              <p class="mypage-shop-meta">
                予算：<%= restaurant.budget %>
              </p>

              <p class="mypage-shop-meta">
                訪問日：<%= visit.visited_at&.strftime("%Y/%m/%d") %>
              </p>

              <div class="mypage-shop-link-wrap">
                <%= link_to "詳細",
                            restaurant_path(restaurant.hotpepper_id),
                            class: "common-link mypage-shop-link" %>
              </div>
            </div>
          </div>
        <% end %>

      <% else %>

        <div class="mypage-empty">
          <p>まだ訪問記録がありません。</p>

          <%= link_to "お店を探す",
                      restaurants_path,
                      class: "ls-submit-button" %>
        </div>

      <% end %>
    </section>
  </div>
</div>