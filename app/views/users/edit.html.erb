<div class="ls-page-bg">
  <div class="ls-page-container">
    <div class="ls-title-box">
      <h1 class="ls-title-text">プロフィール編集</h1>
    </div>

    <div class="ls-form-card">
      <%= form_with(model: @user, local: true) do |f| %>
        <%= render "shared/error_messages" %>

        <div class="ls-form-group">
          <%= f.label :name, "ユーザー名", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.text_field :name,
                             class: "ls-form-input",
                             placeholder: "username",
                             autocomplete: "name" %>
            <span class="ls-input-icon">👤</span>
          </div>
        </div>

        <div class="ls-form-group">
          <%= f.label :email, "メールアドレス", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.email_field :email,
                              class: "ls-form-input",
                              placeholder: "email@example.com",
                              autocomplete: "email" %>
            <span class="ls-input-icon">✉️</span>
          </div>
        </div>

        <div class="ls-form-group">
          <%= f.label :password, "新パスワード", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.password_field :password,
                                 class: "ls-form-input",
                                 placeholder: "変更する場合のみ入力",
                                 autocomplete: "new-password" %>
            <span class="ls-input-icon">🔑</span>
          </div>
        </div>

        <div class="ls-form-group">
          <%= f.label :password_confirmation, "確認用パスワード", class: "ls-form-label" %>
          <div class="ls-input-wrap">
            <%= f.password_field :password_confirmation,
                                 class: "ls-form-input",
                                 placeholder: "変更する場合のみ再入力",
                                 autocomplete: "new-password" %>
            <span class="ls-input-icon">🔒</span>
          </div>
        </div>

        <div class="ls-submit-wrap">
          <%= f.submit "更新する", class: "ls-submit-button" %>
        </div>
      <% end %>
    </div>
  </div>
</div>